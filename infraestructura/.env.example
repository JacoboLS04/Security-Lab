# Variables para el despliegue 3.1/3.2 (OPC Tickets).
# Copiar a `.env` y ajustar:

# 0 = modo produccion (sin recargador del servidor de desarrollo Flask).
FLASK_DEBUG=0

# Secretos del backend. Generar una clave aleatoria, por ejemplo:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=cambia-esta-clave-por-una-aleatoria